{
  "org": "adobedrago",
  "site": "elevance-nc",
  "branch": "main",
  "outputs": {
    "preview": "asset-index-preview.json",
    "live": "asset-index.json"
  },
  "keyPhrases": {
    "outputs": {
      "preview": "search-key-phrases-preview.json",
      "live": "search-key-phrases.json"
    },
    "pageIndexPath": "/query-index.json",
    "excludePaths": ["/footer", "/nav", "/fragments", "/drafts", "/tools", "/search", "/north-carolina-provider/search"],
    "minimumLength": 3,
    "maximumLength": 120,
    "maximumPhrases": 5000
  },
  "roots": ["/docs/gpp"],
  "extensions": ["pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "csv", "rtf", "txt"],
  "minimumFiles": 1,
  "maxFiles": 1000,
  "pdfMaxPages": 0,
  "contentMaxCharacters": 250000,
  "concurrency": 2,
  "allowPartial": false
}
